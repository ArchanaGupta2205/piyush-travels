# ==============================================================================
# BACKEND PRODUCTION ENVIRONMENT VARIABLES
# For deployment on Render / Railway / AWS / VPS / Heroku
# ==============================================================================

PORT=5000
NODE_ENV=production

# MongoDB Production Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/piyush_travels?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=generate_a_long_random_64_character_secret_key_here
JWT_EXPIRE=30d

# Frontend Domain for CORS Whitelist
CLIENT_URL=https://www.piyush-travels.com

# Razorpay Payment Gateway (Live Mode)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_live_razorpay_secret_key

# Cloudinary Storage for Vehicle & Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (Gmail / SendGrid / Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bookings@piyush-travels.com
SMTP_PASS=your_app_password_or_api_key
FROM_EMAIL=bookings@piyush-travels.com
FROM_NAME="Piyush Travels"
